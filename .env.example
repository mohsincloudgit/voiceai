PORT=3000

# ==========================================
# Database Provider (firebase | json | aws)
# Default is firebase with automatic local JSON fallback if credentials are unset
# ==========================================
DB_PROVIDER=firebase

# Firebase Firestore Configuration (Option A: Service Account File - Recommended)
# Download from Firebase Console -> Project Settings -> Service accounts -> Generate new private key
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# Firebase Firestore Configuration (Option B: Individual Env Variables)
# FIREBASE_PROJECT_ID=your-firebase-project-id
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@your-project-id.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Future AWS Provider Settings (Optional - when migrating to AWS DynamoDB)
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Google Gemini API Key (Optional)
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=

# Email SMTP Settings (For receiving lead notifications, bookings & audio transcripts)
# Default is Google Gmail SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false

# Your Gmail address used to dispatch notifications
SMTP_USER=your_email@gmail.com

# 16-character Google App Password (Generate at: https://myaccount.google.com/apppasswords)
# Note: Google 2-Step Verification must be enabled on your account.
SMTP_PASS=your_16_digit_app_password

# Admin email where qualified leads and full transcripts will be delivered
NOTIFICATION_EMAIL=leads_receiver@yourdomain.com
